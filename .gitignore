artifacts
data

# Terraform
# Local modules and plugins (re-downloaded via 'terraform init')
.terraform/

# State files (contain sensitive data and infra status)
*.tfstate
*.tfstate.backup
*.tfstate.lock.info

# Variable files (often contain secrets)
*.tfvars
*.tfvars.json
override.tf
override.tf.json

# Python
# Compiled files and cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# Virtual environments
venv/
.venv/
env/

# Environment and Secrets
# Never commit these to version control
.env
.envrc

# OS and IDE files
.DS_Store
.vscode/
.idea/

# Project specific tools
.agents
.codex

# Coverage reports
.coverage
