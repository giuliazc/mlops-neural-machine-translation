# Configurações do Ambiente MLOps

# Diretório base de todos os modelos salvos
ARTIFACTS_DIR=artifacts

# Run ID ativo ao iniciar a API (Ex: nmt_20260508...)
DEFAULT_RUN_ID=

# Sentry DSN para observabilidade
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=local
SENTRY_TRACES_SAMPLE_RATE=0.2

# API key do AWS API Gateway
API_GATEWAY_API_KEY=

# URL publica do AWS API Gateway
API_BASE_URL=https://id.execute-api.us-east-1.amazonaws.com/dev

# Storage compartilhado dos artefatos aprovados
ARTIFACT_BUCKET=mlops-artifacts-us-east-1
ARTIFACT_PREFIX=models
AWS_REGION=us-east-1
