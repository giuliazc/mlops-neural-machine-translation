{
  "id": "mlops-nmt-pipeline",
  "name": "MLOps Pipeline EN-PT",
  "nodes": [
    {
      "parameters": {
        "content": "## Logica Principal\nWebhook -> Preparar Parametros -> Validar Parametros -> Preparar Dados -> Treinar -> Validar -> Publicar Artefatos -> Deploy -> Resposta JSON",
